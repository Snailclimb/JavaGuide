      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "rollup": ">=4.59.0",
      "dompurify": ">=3.3.2",
      "lodash-es": ">=4.18.0",
      "@xmldom/xmldom": ">=0.9.10",
      "picomatch": ">=4.0.4",
      "immutable": "5.1.8",
      "linkify-it": "5.0.2",
      "markdown-it": "14.2.0",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
